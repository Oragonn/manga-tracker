{
  "manifest_version": 3,
  "name": "Manga Tracker – Kenmei Import Helper",
  "version": "1.1.9",
  "description": "Speeds up matching Kenmei CSV rows on the Manga Tracker import page: opens all 8 source searches per row and lets you grab/skip results with W/U, then confirm with Y. Also works directly on a kenmei.co series page: I opens the same 8 searches, Y copies the matched links to the clipboard. Same K/Y/U keys on the tracker dashboard's own Add Series / Series Settings source searches. Marks the series you already track on kenmei.co's search, discovery and series pages.",
  "permissions": ["tabs", "clipboardWrite", "offscreen", "storage"],
  "host_permissions": [
    "https://mangadex.org/*",
    "https://atsu.moe/*",
    "https://asurascans.com/*",
    "https://kagane.to/*",
    "https://kagane.org/*",
    "https://hivetoons.org/*",
    "https://flamecomics.xyz/*",
    "https://en-thunderscans.com/*",
    "https://comix.to/*",
    "https://kenmei.co/*",
    "https://*.kenmei.co/*",
    "http://*:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mangadex.org/*",
        "https://atsu.moe/*",
        "https://asurascans.com/*",
        "https://kagane.to/*",
        "https://kagane.org/*",
        "https://hivetoons.org/*",
        "https://flamecomics.xyz/*",
        "https://en-thunderscans.com/*",
        "https://comix.to/*"
      ],
      "js": ["content_source.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*:8080/import-kenmei*"
      ],
      "js": ["content_import.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*:8080/*"
      ],
      "exclude_matches": [
        "http://*:8080/import-kenmei*"
      ],
      "js": ["content_dashboard.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kenmei.co/*",
        "https://*.kenmei.co/*"
      ],
      "js": ["content_kenmei.js", "content_kenmei_tracked.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kenmei.co/*",
        "https://*.kenmei.co/*"
      ],
      "js": ["content_kenmei_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
